{
  "name": "code-connect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "preview:web": "pnpm --filter web preview",
    "lint:web": "pnpm --filter web lint",
    "test:web": "pnpm --filter web test",
    "dev:server": "pnpm --filter server start:dev",
    "build:server": "pnpm --filter server build",
    "start:server": "pnpm --filter server start",
    "start:server:prod": "pnpm --filter server start:prod",
    "test:server": "pnpm --filter server test",
    "lint:server": "pnpm --filter server lint"
  }
}
